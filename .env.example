# Deep Research Cockpit - Environment Configuration Template
# Copy this file to .env and fill in the values

# === Application ===
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# === OpenAI ===
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Neo4j Graph Database ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# === OpenSearch ===
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=research

# === Redis Cache ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === Object Storage (S3/MinIO) ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=research-events
S3_REGION=us-east-1

# === Browserbase (for JS rendering) ===
BROWSERBASE_API_KEY=your-browserbase-key
BROWSERBASE_PROJECT_ID=your-project-id

# === Fetch Pipeline ===
FETCH_USER_AGENT=DeepResearchBot/1.0 (+https://example.com/bot)
FETCH_RATE_LIMIT_DEFAULT=1
FETCH_TIMEOUT_MS=30000
FETCH_MAX_RETRIES=3

# === Security ===
JWT_SECRET=your-jwt-secret-here-change-in-production
SESSION_SECRET=your-session-secret-here
CORS_ORIGIN=http://localhost:5173

# === Observability ===
ENABLE_TELEMETRY=true
TELEMETRY_ENDPOINT=http://localhost:4318
